# Copy to .env and fill in real values.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/art_gallery_tutorial?schema=public"
PORT=3000

# Admin panel auth — change these before any non-local use.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
JWT_SECRET="change-me-to-a-long-random-string"

# --- Deployment only -------------------------------------------------------
# These are set on the host (Railway → service → Variables), not in a .env file.
# Enter values there WITHOUT quotes: dotenv strips surrounding quotes, host
# dashboards store them verbatim, so a pasted "false" is the literal 6-char
# string. The shapes below are what the host should hold.
#
# Browser origins allowed to call this API, comma-separated. Unset = the local
# dev servers (localhost:5173, localhost:4173). Set this in production.
# CORS_ORIGIN=https://haydardurmus.com,https://www.haydardurmus.com

# Set to false to omit the /docs OpenAPI UI. Recommended in production.
# ENABLE_DOCS=false

# Where uploaded painting images are stored. Defaults to <cwd>/public, which is
# correct locally and on Railway when the volume is mounted at /app/public.
# Only set this if the volume is mounted somewhere else.
# UPLOADS_ROOT="/app/public"
