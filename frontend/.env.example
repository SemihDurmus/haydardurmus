# Base URL of the Art Gallery 2 backend API. Copy to .env to override the default.
# NOTE: Vite inlines this at BUILD time — changing it in a hosting dashboard
# requires a redeploy, not just a restart. In production point it at the
# deployed API, including the /api suffix:
#   VITE_API_URL=https://api.haydardurmus.com/api
VITE_API_URL=http://localhost:3000/api
